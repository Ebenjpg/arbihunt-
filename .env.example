# ---------------------------------------------------------------
# ArbiHunt Scanner - Local environment configuration
# Copy this file to .env and adjust if needed. All values optional.
# ---------------------------------------------------------------

# Backend HTTP port (frontend proxies /api here)
BACKEND_PORT=3001

# Frontend dev server port (open http://localhost:3000 in the browser)
FRONTEND_PORT=3000

# Comma separated list of enabled exchange ids ("" = all enabled)
# Example: ENABLED_EXCHANGES=binance,bybit,okx,gate,mexc
ENABLED_EXCHANGES=

# Comma separated list of disabled exchange ids
DISABLED_EXCHANGES=

# Poll intervals (milliseconds)
TICKER_POLL_MS=12000
ORDERBOOK_POLL_MS=1500
SCAN_INTERVAL_MS=5000

# Candidate pairs evaluated per scan cycle. This is a BATCH budget, NOT a cap:
# the engine rotates through the full market universe, so no market is dropped
# regardless of size. Increase if the scanner has more headroom.
MAX_CANDIDATES_PER_SCAN=200

# Order-book TTL cache capacity (entries). Scales with total market count.
ORDERBOOK_CACHE_CAPACITY=200000

# How long discovered opportunities stay visible on the dashboard before being
# pruned (ms). Decoupled from the scan interval so results persist even when
# scan cycles are slow. Marked EXPIRED at half this time.
OPPORTUNITY_RETENTION_MS=300000

# Live asset/network metadata (contracts, chains, withdrawal fees, deposit and
# withdrawal status) is fetched from public exchange APIs (Gate, Bitget, HTX,
# Poloniex, KuCoin). This is the PRIMARY source of truth for asset identity.
# staticNetworks.ts is only a fallback for exchanges that do not expose this.
LIVE_METADATA_ENABLED=true
# Refresh interval for live metadata (ms)
ASSET_METADATA_REFRESH_MS=900000

# WebSocket real-time market data for supported exchanges (binance/bybit/okx)
WS_ENABLED=true

# Global capital input (USD) - also changeable from the UI
DEFAULT_CAPITAL=100

# Minimum net profit % required for a live opportunity (default 0.10)
MIN_PROFIT_PCT=0.10

# Data freshness thresholds (ms) - FRESH / AGING / STALE
FRESH_MAX_MS=5000
STALE_MAX_MS=15000

# DEMO_MODE=true generates clearly-labeled demo opportunities
# for testing the UI without internet access. Never mixed with live data.
DEMO_MODE=false

# Optional: some exchanges require an API key even for public metadata.
# These are READ-ONLY keys only. Do NOT grant withdrawal or trading permissions.
# Only a few exchanges (e.g. Bitget, BingX, XT) accept optional keys.
# BINGX_API_KEY=pam49Kbp9Q0WhqhPZoItGWGEMAll6ANTo113xWpoJSbnjK6uBf8UQoSd5bWoI1FWUdl0t6DIUCpGnVBfPU3ig
# BINGX_API_SECRET=pOuahasCWXdKkGab1wBxSJi9tBDeAhrOjW1CVAaVMHq8VcYkb2di9BlttCMoQAaSjgwXN3ALN1L6oXg
# BITGET_API_KEY=bg_73dc373be929019e650af54a0da6f4b3
# BITGET_API_SECRET=946d5990309428b8a09948afb6f229e68fd7444ae4a941efdbfc0c9f1ae80542
# XT_API_KEY=75e2bf694947b2ec44e42dcce16abe7e09bef9f7

# MEXC / Bybit / Bitrue do NOT expose withdrawal/deposit network fees on
# unauthenticated endpoints. Supply an optional READ-ONLY key + secret to pull
# LIVE withdrawal fees, networks and deposit/withdraw status for those
# exchanges. Without a key the scanner reports NETWORK UNKNOWN (never a fake
# $0 fee).
# MEXC_API_KEY=mx0vgleEUgwsNZvSeE
# MEXC_API_SECRET=aff35fe373cf45bfa62c1b879c59bda8
# BYBIT_API_KEY=mx0vgleEUgwsNZvSeE
# BYBIT_API_SECRET=aff35fe373cf45bfa62c1b879c59bda8
# BITRUE_API_KEY=adcb4befde7294eac4b7895624b24a6f9808b2670399d49432755441a7b3325e
# BITRUE_API_SECRET=93be4864d7ff078085d64f82c04cf1b282d1ce8b4162551f879008fffb506135
#
# Binance / OKX also need a READ-ONLY key (OKX additionally requires the API
# passphrase used when the key was created). All keys/signatures are used only
# for public market metadata; never grant withdrawal or trading permissions.
# BINANCE_API_KEY=nReGKnyGX8KRGTLFzPv3SIFTRVigU7oxQweWGZFOeZGv9202b7Shnnsx9F5O7S5R
# BINANCE_API_SECRET=CT2kYjxneKFSUuf4fF1zN4GAZG9ogGigZxq2mmkXIp62GfPX1bhVe0PfiIi3Z5h1
# OKX_API_KEY=e5cdf2cb-79ca-4227-a8a9-b102e2423286
# OKX_API_SECRET=02713CF83151A00F84678E6053FD6C58
# OKX_API_PASSPHRASE=Eben@2004
#
# XT / BTSE are PUBLIC — no keys needed.
#
# BingX / Crypto.com / Phemex gate network/fee metadata behind a signed
# READ-ONLY key. Add them if you create keys.
# BINGX_API_KEY=pam49Kbp9Q0WhqhPZoItGWGEMAll6ANTo113xWpoJSbnjK6uBf8UQoSd5bWoI1FWUdl0t6DIUCpGnVBfPU3ig
# BINGX_API_SECRET=pOuahasCWXdKkGab1wBxSJi9tBDeAhrOjW1CVAaVMHq8VcYkb2di9BlttCMoQAaSjgwXN3ALN1L6oXg
# CRYPTOCOM_API_KEY=cdc_14877fa2550590defa37a77866f7
# CRYPTOCOM_API_SECRET=Gg8bCq2QcnNHtVmIC+zKl+42TSaIzAQaBlq5zUOnLqc=
# PHEMEX_API_KEY=8c18de8b-c5d4-4e3e-9e09-fb2242b97bea
# PHEMEX_API_SECRET=8c18de8b-c5d4-4e3e-9e09-fb2242b97bea
#
# AscendEX / Toobit / LATOKEN / Bitfinex: no usable network/fee endpoint even
# with a key (tested 404/empty or fee-absent), so wiring them would not help.
# LATOKEN_API_KEY=ee7667aa-1e7d-4764-b072-064d854cde85
# LATOKEN_API_SECRET=NjM2ZTQ1OWUtNWU0MS00OTJhLWE0MjctNzc3ZGM4OWY0NTFi
# BITFINEX_API_KEY=0f596bad7295ffd3db64ecb63f14dac3949faf8cf5c
# BITFINEX_API_SECRET=cdfa8e1936ea4a80b032f81a7d4b9641e7c001e0d92
